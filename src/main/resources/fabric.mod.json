{
    "schemaVersion": 1,
    "id": "xaerodisabledradarfixer",
    "version": "${version}",

    "name": "Xaero Disabled Radar Fixer",
    "description": "Blocks server-side attempts to silently disable the radar in Xaero's Minimap and World Map.",
    "authors": ["Laviesss"],

    "contact": {
        "homepage": "https://github.com/Laviesss/XDRF",
        "sources": "https://github.com/Laviesss/XDRF"
    },

    "license": "Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International (CC BY-NC-ND 4.0)",
    "environment": "client",

    "entrypoints": {
        "client": ["com.laviesss.xaerodisabledradarfixer.XaeroDisabledRadarFixer"],
        "modmenu": [
          {
            "adapter": "versiont+modmenu",
            "value": "com.laviesss.xaerodisabledradarfixer.ModMenuEntrypoint"
          }
        ]
    },

    "mixins": ["mixins.xaerodisabledradarfixer.json"],

    "depends": {
        "fabricloader": ">=0.15.0",
        "minecraft": ">=1.21 <=26.2",
        "modmenu": "*",
        "yet_another_config_lib_v3": ">=3.6.2",
        "versiont": "~1.3.2"
    }
}